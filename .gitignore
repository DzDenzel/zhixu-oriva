# Public repository boundary: product source, deployment tools and release workflow.
/*
!/android/
!/backend/
!/deploy/
!/.github/
!/README.md
!/LICENSE
!/.gitignore
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/today-ink.png
!/docs/screenshots/today-atlas.png
!/docs/screenshots/today-phosphor.png

# Generated Android/Java builds and compiler state.
**/build/
**/target/
**/.gradle/
**/.gradle-home/
**/.android-home/
**/.kotlin/
**/.cxx/
**/node_modules/
**/dist/
**/*.class
**/*.pyc
**/__pycache__/
**/*.log
**/*.lastUpdated
/backend/org/

# Local IDE, machine paths and credentials; never publish signing keys.
**/.idea/
**/.vscode/
**/local.properties
**/.env
**/.env.*
**/.plugin-signing/
**/.secrets/
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.key
**/*.pem

# Private governance, requirements, evidence, delivery assets and scratch data.
/AGENTS.md
/Obsidian/
/work/
/release/
/.claude/
/.superpowers/
/.android/
/.secrets/
**/work/
**/tmp/
/deploy/backups/
